#!/bin/sh
python3 -m unittest discover -s scripts -p 'test_*.py' || exit 1
staged=$(git diff --cached --name-only --diff-filter=ACM) || exit 1
if printf '%s\n' "$staged" | grep -Eq '\.rs$|^Cargo\.toml$|^rustfmt'; then
    sh scripts/fmt.sh --check || exit 1
    cargo clippy --locked --all-targets --all-features -- -D warnings || exit 1
fi
