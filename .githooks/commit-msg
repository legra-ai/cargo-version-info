#!/usr/bin/env bash

# Usage: commit-msg <path-to-commit-message>
if [ -z "${1:-}" ]; then
    echo "Usage: commit-msg <path-to-commit-message>" >&2
    exit 1
fi
MSG_FILE="$1"

# Require cocogitto to be installed
if ! command -v cog >/dev/null 2>&1; then
  echo "cog (cocogitto) is required to commit. Install with: cargo install cocogitto" >&2
  exit 1
fi

# Verify commit message with cocogitto (single message)
if ! cog verify --file "$MSG_FILE" >/dev/null; then
  echo "Commit message does not follow Conventional Commits." >&2
  exit 1
fi

# Validate the headline independently of body text.
IFS= read -r headline < "$MSG_FILE" || { printf 'Cannot read commit headline\n' >&2; exit 1; }
if ! printf '%s\n' "$headline" | grep -Eq '^(feat|fix|build|chore|docs|style|ci|refactor|perf|test|revert)\([a-z0-9][a-z0-9./-]*\)!?: [^[:space:]](.*[^[:space:]])?$'; then
  echo "Required commit headline: type(scope): description (optional ! before colon)" >&2
  exit 1
fi

exit 0


